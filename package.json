{
   "name": "nosql-ecommerce",
   "version": "1.0.0",
   "description": "E-commerce platform with MongoDB backend and Next.js frontend",
   "scripts": {
      "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
      "dev:backend": "cd backend && npm run dev",
      "dev:frontend": "cd frontend && npm run dev",
      "install:all": "npm install && cd backend && npm install && cd ../frontend && npm install"
   },
   "keywords": [
      "mongodb",
      "nosql",
      "ecommerce",
      "nextjs"
   ],
   "author": "",
   "license": "MIT",
   "devDependencies": {
      "concurrently": "^8.2.2"
   },
   "dependencies": {
      "swagger-jsdoc": "^6.2.8",
      "swagger-ui-express": "^5.0.1"
   }
}
